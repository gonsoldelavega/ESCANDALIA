# Public Supabase browser config
# These values are safe to use in the frontend when they are the project URL and anon public key.
# Never commit the service_role key.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — usado por /api/scan-invoice para el OCR de facturas con Claude.
# NUNCA exponer en el frontend ni commitear el valor real.
ANTHROPIC_API_KEY=sk-ant-...
