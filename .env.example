# Public Supabase browser config
# These values are safe to use in the frontend when they are the project URL and anon public key.
# Never commit the service_role key.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — usado por /api/scan-invoice para el OCR de facturas.
# Google Cloud Vision: 1.000 facturas/mes gratis, luego ~1,50€/1.000.
# Crear en Google Cloud Console → APIs & Services → Credentials → API Key,
# habilitando la Cloud Vision API. NUNCA exponer en el frontend.
GOOGLE_VISION_API_KEY=AIza...
